#!/bin/bash
# Loop driver: reads a prompt template from the given file and re-invokes Claude with it
# until the assistant emits <promise>NO MORE TASKS</promise> or max iterations is hit.
# Occurrences of $PARENT in the template are substituted with the parent ticket ID.
set -eo pipefail

PROMPT_FILE="$1"
PARENT="$2"
MAX_ITER="${3:-10}"

if [ -z "$PROMPT_FILE" ] || [ -z "$PARENT" ]; then
  echo "Usage: specular-ralph <prompt-file> <parent-issue-id> [max-iterations]"
  echo "  prompt-file:     path to prompt template (\$PARENT is substituted)"
  echo "  parent-issue-id: e.g. ABC-123"
  echo "  max-iterations:  default 10"
  exit 1
fi

if [ ! -f "$PROMPT_FILE" ]; then
  echo "Error: prompt file not found at $PROMPT_FILE" >&2
  exit 1
fi

# Single-instance lock per parent ticket. Prevents duplicate drivers from
# racing on the same worktree if /specular:implement is invoked twice or
# Claude redundantly Bash-invokes this script. mkdir is atomic on POSIX,
# so this works without flock (which macOS doesn't ship).
LOCK_DIR="${TMPDIR:-/tmp}/specular-ralph-${PARENT}.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  existing_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "?")
  # Stale-lock recovery: if the recorded pid is gone, take over.
  if [ "$existing_pid" != "?" ] && ! kill -0 "$existing_pid" 2>/dev/null; then
    echo "Note: stale lock from pid $existing_pid; taking over." >&2
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR"
  else
    echo "Error: another specular-ralph is already running for $PARENT (pid $existing_pid). Refusing to start a duplicate." >&2
    echo "If you're sure nothing is running, remove $LOCK_DIR and retry." >&2
    exit 1
  fi
fi
echo $$ > "$LOCK_DIR/pid"

PROMPT="$(cat "$PROMPT_FILE")"
PROMPT="${PROMPT//\$PARENT/$PARENT}"

stream_text='select(.type == "assistant").message.content[]? | select(.type == "text").text // empty | gsub("\n"; "\r\n") | . + "\r\n\n"'
final_result='select(.type == "result").result // empty'

tmpfile=$(mktemp)
trap 'rm -rf "$LOCK_DIR"; rm -f "$tmpfile"' EXIT

for ((i=1; i<=MAX_ITER; i++)); do
  echo ""
  echo "=== specular ralph: iteration $i/$MAX_ITER (parent=$PARENT) ==="
  echo ""

  : > "$tmpfile"

  claude \
    --permission-mode acceptEdits \
    --verbose \
    --print \
    --output-format stream-json \
    "$PROMPT" \
    | grep --line-buffered '^{' \
    | tee "$tmpfile" \
    | jq --unbuffered -rj "$stream_text"

  result=$(jq -r "$final_result" "$tmpfile")

  if [[ "$result" == *"<promise>NO MORE TASKS</promise>"* ]]; then
    echo ""
    echo "=== specular ralph: complete after $i iterations ==="
    exit 0
  fi
done

echo ""
echo "=== specular ralph: hit max iterations ($MAX_ITER) ==="
